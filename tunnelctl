#!/bin/bash
# tunnelctl - manage JSON-configured SSH/IAP tunnels via launchd.
#
#   tunnelctl sync              Generate/refresh a launchd plist per tunnel in tunnels.json;
#                               load new tunnels, unload ones removed from config.
#   tunnelctl add               Interactive: append a tunnel to tunnels.json, then sync.
#   tunnelctl add-bastion       Interactive: define a bastion (alias/instance/zone/project).
#   tunnelctl status            Real-health table for all tunnels + watchdog state.
#   tunnelctl restart <name|all>
#   tunnelctl logs <name>       Tail that tunnel's logs.
#   tunnelctl remove <name>     Unload + remove from tunnels.json.
#   tunnelctl validate          Check JSON for errors / duplicate names+ports.
#   tunnelctl edit              Open tunnels.json in $EDITOR.

set -uo pipefail

export PATH="$HOME/google-cloud-sdk/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="${TUNNELS_PYTHON:-/usr/bin/python3}"
LIB="$DIR/_lib.py"
CONF="$DIR/tunnels.json"
LOGS="$DIR/logs"
LA="$HOME/Library/LaunchAgents"
PREFIX="${TUNNELS_PREFIX:-com.fynd.tunnel}"
UID_NUM=$(id -u)
MONGO_PING="$DIR/mongo_ping.py"
PROBE_TIMEOUT=5

names() { "$PY" "$LIB" names; }
field() { "$PY" "$LIB" field "$1" "$2"; }

probe() { # port type
  case "$2" in
    pg)    pg_isready -h 127.0.0.1 -p "$1" -t "$PROBE_TIMEOUT" -q; local r=$?; [ "$r" -eq 0 ] || [ "$r" -eq 1 ] ;;
    mongo) "$PY" "$MONGO_PING" "$1" "$PROBE_TIMEOUT" >/dev/null 2>&1 ;;
    tcp)   nc -z -G "$PROBE_TIMEOUT" 127.0.0.1 "$1" >/dev/null 2>&1 ;;
  esac
}

write_plist() {
  local name="$1"
  local label="$PREFIX.$name"
  cat > "$LA/$label.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$label</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>$DIR/run-tunnel.sh</string>
        <string>$name</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>$LOGS/$name.out.log</string>
    <key>StandardErrorPath</key>
    <string>$LOGS/$name.err.log</string>
</dict>
</plist>
EOF
}

load_agent()   { launchctl bootstrap "gui/$UID_NUM" "$LA/$PREFIX.$1.plist" 2>/dev/null; }
unload_agent() { launchctl bootout "gui/$UID_NUM/$PREFIX.$1" 2>/dev/null; }
is_loaded()    { launchctl list 2>/dev/null | grep -q "$PREFIX.$1$"; }

cmd_validate() { "$PY" "$LIB" validate; }

cmd_sync() {
  "$PY" "$LIB" validate >/dev/null || { echo "Config invalid. Run: tunnelctl validate"; return 1; }
  mkdir -p "$LOGS"
  local -a want=(); while IFS= read -r n; do want+=("$n"); done < <(names)

  echo "Syncing ${#want[@]} tunnel(s) from tunnels.json ..."
  for n in "${want[@]}"; do
    write_plist "$n"
    if is_loaded "$n"; then
      launchctl kickstart -k "gui/$UID_NUM/$PREFIX.$n" 2>/dev/null
      echo "  refreshed: $n"
    else
      load_agent "$n" && echo "  loaded:    $n"
    fi
  done

  # Unload any loaded fynd tunnel no longer in config (skip the watchdog).
  while IFS= read -r label; do
    local short="${label#$PREFIX.}"
    [ "$short" = "healthcheck" ] && continue
    local keep=0; for n in "${want[@]}"; do [ "$n" = "$short" ] && keep=1; done
    if [ "$keep" -eq 0 ]; then
      unload_agent "$short"; rm -f "$LA/$label.plist"
      echo "  removed:   $short (not in config)"
    fi
  done < <(launchctl list | awk '{print $3}' | grep "^$PREFIX\." | grep -v "$PREFIX.healthcheck")
  echo "Sync complete. (give tunnels ~10s, then: tunnelctl status)"
}

cmd_status() {
  printf "%-22s %-9s %-7s %-7s %-38s %s\n" "NAME" "STATE" "PID" "HEALTH" "MAPPING (local -> remote)" "DESCRIPTION"
  printf "%-22s %-9s %-7s %-7s %-38s %s\n" "----" "-----" "---" "------" "-------------------------" "-----------"
  while IFS= read -r n; do
    local label="$PREFIX.$n" port type desc rhost rport info state pid health mapping
    port=$(field "$n" local_port); type=$(field "$n" type); desc=$(field "$n" description)
    rhost=$(field "$n" remote_host); rport=$(field "$n" remote_port)
    mapping="127.0.0.1:$port -> $rhost:$rport"
    info=$(launchctl print "gui/$UID_NUM/$label" 2>/dev/null)
    if [ -z "$info" ]; then state="UNLOADED"; pid="-"; else
      state=$(echo "$info" | grep -m1 "state = " | sed 's/.*state = //;s/[[:space:]]*$//')
      pid=$(echo "$info" | grep -m1 "pid = " | sed 's/.*pid = //;s/[[:space:]]*$//'); [ -z "$pid" ] && pid="-"
    fi
    if probe "$port" "$type"; then health="OK"; else health="FAIL"; fi
    printf "%-22s %-9s %-7s %-7s %-38s %s\n" "$n" "${state:-?}" "$pid" "$health" "$mapping" "$desc"
  done < <(names)

  echo ""
  if launchctl list | grep -q "$PREFIX.healthcheck"; then
    echo "Watchdog: LOADED (probes every 60s + on wake)"
  else
    echo "Watchdog: NOT LOADED  ->  launchctl bootstrap gui/$UID_NUM $LA/$PREFIX.healthcheck.plist"
  fi
  echo ""
  echo "Recent watchdog activity:"
  tail -4 "$LOGS/healthcheck.log" 2>/dev/null | sed 's/^/  /' || echo "  (none)"
  echo ""
  echo "FAIL + auth OK  -> watchdog auto-restarts within ~60s."
  echo "FAIL + auth bad -> run 'gcloud auth login' (watchdog stands down on auth)."
}

cmd_restart() {
  local t="${1:?usage: tunnelctl restart <name|all>}"
  if [ "$t" = "all" ]; then
    while IFS= read -r n; do launchctl kickstart -k "gui/$UID_NUM/$PREFIX.$n" 2>/dev/null && echo "restarted $n"; done < <(names)
  else
    field "$t" name >/dev/null 2>&1 || { echo "unknown tunnel: $t"; return 1; }
    launchctl kickstart -k "gui/$UID_NUM/$PREFIX.$t" && echo "restarted $t"
  fi
  echo "waiting 12s..."; sleep 12; cmd_status
}

cmd_logs() {
  local n="${1:?usage: tunnelctl logs <name>}"
  tail -f "$LOGS/$n.err.log" "$LOGS/$n.out.log"
}

cmd_add() {
  echo "Add a new tunnel (infra only - no DB passwords)."
  read -r -p "  name (e.g. myapp-uat): " name
  read -r -p "  local_port (e.g. 12000): " lport
  read -r -p "  remote_host (DB IP): " rhost
  read -r -p "  remote_port [5432]: " rport; rport="${rport:-5432}"
  read -r -p "  type pg|mongo|tcp [pg]: " type; type="${type:-pg}"
  echo "  available bastions: $("$PY" - "$CONF" <<'PYEOF'
import json,sys; print(", ".join(json.load(open(sys.argv[1])).get("bastions",{})))
PYEOF
)"
  read -r -p "  bastion (alias): " bastion
  read -r -p "  description: " desc

  "$PY" - "$CONF" "$name" "$lport" "$rhost" "$rport" "$type" "$bastion" "$desc" <<'PYEOF'
import json, sys
conf, name, lport, rhost, rport, type_, bastion, desc = sys.argv[1:9]
data = json.load(open(conf))
if bastion not in data.get("bastions", {}):
    sys.exit(f"error: unknown bastion alias '{bastion}'. "
             f"Define it under \"bastions\" first, or use one of: "
             f"{', '.join(data.get('bastions', {}))}")
if any(t["name"] == name for t in data["tunnels"]):
    sys.exit(f"error: name '{name}' already exists")
if any(t["local_port"] == int(lport) for t in data["tunnels"]):
    sys.exit(f"error: local_port {lport} already in use")
data["tunnels"].append({
    "name": name, "local_port": int(lport), "remote_host": rhost,
    "remote_port": int(rport), "type": type_, "bastion": bastion,
    "description": desc or name,
})
json.dump(data, open(conf, "w"), indent=2)
open(conf, "a").write("\n")
print(f"added '{name}' to tunnels.json")
PYEOF
  [ $? -eq 0 ] || { echo "add aborted."; return 1; }
  cmd_sync
}

cmd_remove() {
  local n="${1:?usage: tunnelctl remove <name>}"
  unload_agent "$n"; rm -f "$LA/$PREFIX.$n.plist"
  "$PY" - "$CONF" "$n" <<'PYEOF'
import json, sys
conf, name = sys.argv[1], sys.argv[2]
data = json.load(open(conf))
before = len(data["tunnels"])
data["tunnels"] = [t for t in data["tunnels"] if t["name"] != name]
if len(data["tunnels"]) == before:
    sys.exit(f"warning: '{name}' was not in config")
json.dump(data, open(conf, "w"), indent=2); open(conf, "a").write("\n")
print(f"removed '{name}' from tunnels.json")
PYEOF
  echo "done."
}

cmd_add_bastion() {
  echo "Define a bastion (each bastion belongs to one GCP project)."
  read -r -p "  alias (e.g. prod): " alias
  read -r -p "  instance (gcloud VM name): " instance
  read -r -p "  zone (e.g. us-central1-a): " zone
  read -r -p "  project (GCP project id): " project

  "$PY" - "$CONF" "$alias" "$instance" "$zone" "$project" <<'PYEOF'
import json, sys
conf, alias, instance, zone, project = sys.argv[1:6]
data = json.load(open(conf))
data.setdefault("bastions", {})
if alias in data["bastions"]:
    sys.exit(f"error: bastion alias '{alias}' already exists")
if not (alias and instance and zone):
    sys.exit("error: alias, instance and zone are required")
spec = {"instance": instance, "zone": zone}
if project:
    spec["project"] = project
data["bastions"][alias] = spec
json.dump(data, open(conf, "w"), indent=2); open(conf, "a").write("\n")
print(f"added bastion '{alias}' (project: {project or 'defaults.project'})")
PYEOF
  [ $? -eq 0 ] && echo "Reference it from a tunnel's \"bastion\" field, then: tunnelctl sync"
}

cmd_edit() { "${EDITOR:-vi}" "$CONF"; echo "Run 'tunnelctl sync' to apply."; }

usage() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  sync)         cmd_sync ;;
  add)          cmd_add ;;
  add-bastion)  cmd_add_bastion ;;
  status|"")    cmd_status ;;
  restart)      cmd_restart "${2:-}" ;;
  logs)         cmd_logs "${2:-}" ;;
  remove)       cmd_remove "${2:-}" ;;
  validate)     cmd_validate ;;
  edit)         cmd_edit ;;
  -h|--help|help) usage ;;
  *) echo "unknown command: $1"; usage; exit 1 ;;
esac
